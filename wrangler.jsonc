/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webtools",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-15",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"ai": { "binding": "AI" },
	"containers": [
		{
			"class_name": "SteelBrowser",
			"image": "./Dockerfile",
			"instance_type": "standard-2",
			"max_instances": 100,
		},
	],
	"durable_objects": {
		"bindings": [
			{ "class_name": "WebToolsMCP", "name": "MCP_OBJECT" },
			{ "class_name": "SteelBrowser", "name": "STEEL" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["WebToolsMCP"] },
		{ "tag": "v2", "new_sqlite_classes": ["SteelBrowser"] },
	],
	// Secrets (set via `wrangler secret put` or `.dev.vars` locally):
	// - API_KEY: shared key required by the worker (Authorization: Bearer or ?key=)
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
