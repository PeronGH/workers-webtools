/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stealth-webtools",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-15",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"ai": { "binding": "AI" },
	"containers": [
		{
			"class_name": "CloakBrowser",
			"image": "./container/Dockerfile",
			"instance_type": "standard-4",
			"max_instances": 1,
		},
	],
	"durable_objects": {
		"bindings": [
			{ "class_name": "WebToolsMCP", "name": "MCP_OBJECT" },
			{ "class_name": "CloakBrowser", "name": "CLOAK" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["WebToolsMCP", "CloakBrowser"] },
	],
	// Secrets (set via `wrangler secret put` or `.dev.vars` locally):
	// - API_KEY: shared key required by the worker (Authorization: Bearer or ?key=)
}
